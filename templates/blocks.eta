<% it.blocks.forEach((block) => { %>
  <% if (block.type === "diagram") { %>
    <figure class="my-4" x-data="diagram">
      <figcaption class="fw-semibold mb-2 d-flex align-items-center justify-content-between gap-2">
        <span><%= block.title %></span>
        <small class="text-body-secondary">Cliquez sur un nœud pour ouvrir sa référence scientifique.</small>
        <button type="button" class="btn btn-outline-primary btn-sm" :disabled="!ready" @click="exportDiagram()" aria-label="Télécharger le diagramme « <%= block.title %> » en PNG">
          <svg aria-hidden="true" width="18" height="18"><use href="assets/formats.svg?v=2#png"></use></svg> PNG
        </button>
      </figcaption>
      <div x-ref="view" class="diagram-view border rounded" data-graph="<%= JSON.stringify(block) %>" role="img" aria-label="<%= block.title %>"></div>
      <ul class="visually-hidden-focusable" aria-label="Références scientifiques des nœuds">
        <% block.nodes.forEach((node) => { %><li><a href="<%= node.url %>" target="_blank" rel="noopener noreferrer"><%= node.label %> — <%= node.reference %></a></li><% }) %>
      </ul>
    </figure>
  <% } %>
  <% if (block.type === "heading") { %><h<%= block.level %> class="mt-4 mb-3"><%= block.text %></h<%= block.level %>><% } %>
  <% if (block.type === "paragraph") { %><p class="document-paragraph mb-3"><%= block.text %></p><% } %>
  <% if (block.type === "link") { %><p class="document-paragraph mb-3"><a href="<%= block.url %>"><%= block.text %></a></p><% } %>
  <% if (block.type === "quote") { %><blockquote class="document-quote blockquote border-start border-4 border-primary ps-3 my-4"><p><%= block.text %></p></blockquote><% } %>
  <% if (block.type === "code") { %><pre class="bg-body-tertiary text-body border rounded p-3 mb-3"><code><%= block.text %></code></pre><% } %>
  <% if (block.type === "list") { %>
    <% if (block.ordered) { %><ol class="mb-3 ps-4"><% block.items.forEach((item) => { %><li class="mb-2"><%= item %></li><% }) %></ol><% } else { %><ul class="mb-3 ps-4"><% block.items.forEach((item) => { %><li class="mb-2"><%= item %></li><% }) %></ul><% } %>
  <% } %>
  <% if (block.type === "separator") { %><hr class="my-4"><% } %>
<% }) %>

