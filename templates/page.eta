<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.document.title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.8/dist/minty/bootstrap.min.css">
  <style>
    .document-paragraph,.document-quote{white-space:pre-wrap}pre{overflow:auto}footer{font-size:.875rem}
    @media print{.container{max-width:none!important}.document-footer{break-inside:avoid}}
  </style>
</head>
<body class="bg-body text-body">
  <main class="container py-5">
    <%~ include("@header", it.header) %>
    <article class="mt-4"><%~ include("@blocks", { blocks: it.content }) %></article>
    <%~ include("@footer", it.footer) %>
  </main>
</body>
</html>
