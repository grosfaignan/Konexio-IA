{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grosfaignan.github.io/Konnexio-IA/schemas/document.schema.json",
  "title": "Document Konnexio IA",
  "type": "object",
  "required": ["schemaVersion", "title", "description", "category", "content"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "string", "minLength": 1 },
    "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "object", "required": ["type", "level", "text"], "properties": { "type": { "const": "heading" }, "level": { "type": "integer", "minimum": 1, "maximum": 3 }, "text": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "paragraph" }, "text": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["type", "items"], "properties": { "type": { "const": "list" }, "ordered": { "type": "boolean" }, "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } }, "additionalProperties": false },
          { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "quote" }, "text": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "code" }, "text": { "type": "string" }, "language": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["type", "text", "url"], "properties": { "type": { "const": "link" }, "text": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri", "pattern": "^https://" } }, "additionalProperties": false },
          { "type": "object", "required": ["type"], "properties": { "type": { "const": "separator" } }, "additionalProperties": false }
        ]
      }
    }
  },
  "additionalProperties": false
}

