{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grosfaignan.github.io/Konnexio-IA/schemas/document.schema.json",
  "title": "Document Konnexio IA",
  "type": "object",
  "required": ["schemaVersion", "title", "description", "category", "content"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "string", "minLength": 1 },
    "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/diagram" },
          { "type": "object", "required": ["type", "level", "text"], "properties": { "type": { "const": "heading" }, "level": { "type": "integer", "minimum": 1, "maximum": 3 }, "text": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "paragraph" }, "text": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["type", "items"], "properties": { "type": { "const": "list" }, "ordered": { "type": "boolean" }, "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } }, "additionalProperties": false },
          { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "quote" }, "text": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "code" }, "text": { "type": "string" }, "language": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["type", "text", "url"], "properties": { "type": { "const": "link" }, "text": { "type": "string", "minLength": 1 }, "url": { "type": "string", "format": "uri", "pattern": "^https://" } }, "additionalProperties": false },
          { "type": "object", "required": ["type"], "properties": { "type": { "const": "separator" } }, "additionalProperties": false }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "diagram": {
      "type": "object",
      "description": "Diagramme affiché dans l’aperçu. Chaque identifiant de nœud est unique et chaque lien relie deux nœuds déclarés dans le même bloc.",
      "examples": [{
        "type": "diagram",
        "title": "Parcours de lecture",
        "nodes": [
            { "id": "catalogue", "label": "Catalogue", "reference": "Vaswani et al. (2017) — Attention Is All You Need, NeurIPS", "url": "https://proceedings.neurips.cc/paper_files/paper/2017/hash/3f5ee243547dee91fbd053c1c4a845aa-Abstract.html" },
            { "id": "apercu", "label": "Aperçu", "reference": "Vaswani et al. (2017) — Attention Is All You Need, NeurIPS", "url": "https://proceedings.neurips.cc/paper_files/paper/2017/hash/3f5ee243547dee91fbd053c1c4a845aa-Abstract.html" }
        ],
        "edges": [{ "from": "catalogue", "to": "apercu", "label": "Ouvrir" }]
      }],
      "required": ["type", "title", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "diagram" },
        "title": { "$ref": "#/$defs/text" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "label", "reference", "url"], "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "label": { "$ref": "#/$defs/text" },
              "reference": { "$ref": "#/$defs/text" },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object", "required": ["from", "to"], "additionalProperties": false,
            "properties": {
              "from": { "$ref": "#/$defs/text" }, "to": { "$ref": "#/$defs/text" },
              "label": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    }
  }
}


